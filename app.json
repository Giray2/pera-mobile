{
  "expo": {
    "name": "PERA",
    "slug": "PERA-Mobile",
    "version": "2.1.0",
    "description": "PAKSET çalışanları için sesli ve yazılı yapay zeka asistanı destekli görev ve iş takip uygulaması.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pakset.pera",
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "PERA, söylediklerinizi metne dönüştürmek için konuşma tanıma özelliğini kullanır.",
        "NSMicrophoneUsageDescription": "PERA, sesli soru sormak için mikrofona erişim gerektiriyor.",
        "NSPhotoLibraryUsageDescription": "PERA, görev ve bildirimlere eklenen görselleri kaydetmek/görüntülemek için fotoğraf kütüphanesine erişim gerektirebilir.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.pakset.pera",
      "usesCleartextTraffic": true,
      "versionCode": 20,
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#0A1628",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "PERA, sesli soru sormak için mikrofona erişim gerektiriyor."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PERA, sesli soru sormak için mikrofona erişim gerektiriyor.",
          "speechRecognitionPermission": "PERA, söylediklerinizi metne dönüştürmek için konuşma tanıma özelliğini kullanır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#020B14",
          "defaultChannel": "pera-gorev-kanal"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "networkSecurityConfig": "./network_security_config.xml"
          }
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1ce9e6c6-219e-45f0-a01b-63105ce2776a"
      }
    }
  }
}
